# Application
NODE_ENV=production
APP_URL=https://faizzab.com

# MySQL / MariaDB (Hostinger)
# Example: mysql://USER:PASSWORD@127.0.0.1:3306/DATABASE_NAME
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME"

# Session / auth
# Use a long random string in production (32+ characters)
SESSION_SECRET="replace-with-long-random-secret"

# SMTP (Hostinger or other provider)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@faizzab.com
SMTP_PASS=
SMTP_FROM="FaizZab Website <info@faizzab.com>"
CONTACT_NOTIFICATION_TO=info@faizzab.com

# Initial Super Admin bootstrap (used once via npm run bootstrap:admin)
ADMIN_BOOTSTRAP_NAME="Site Administrator"
ADMIN_BOOTSTRAP_EMAIL=you@example.com
ADMIN_BOOTSTRAP_PASSWORD=

# Optional
GOOGLE_SITE_VERIFICATION=
